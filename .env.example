# Copie para .env.local e preencha somente no seu computador.
# Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
# Supabase: true. PostgreSQL local em localhost: false.
DATABASE_SSL=true
# Certificado CA do Supabase em PEM; represente quebras de linha por \n.
DATABASE_CA=
# 64 caracteres hexadecimais aleatórios; veja npm run auth:secret.
AUTH_SECRET=
# Deve ser exatamente a origem usada no navegador, sem barra final.
APP_ORIGIN=http://localhost:3000
